# Embedding Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=auto  # Options: cuda, cpu, auto
ALLOW_EMBEDDING_FALLBACK=false  # Only enable hashed embeddings for local tests
INDEX_SCHEMA_VERSION=1

# LLM Configuration
LLM_PROVIDER=openai  # openai or gemini
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
# Legacy compatibility only; prefer the provider-specific key above.
LLM_API_KEY=
LLM_LEGACY_COMPAT=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss  # Options: faiss, simple
INDEX_PATH=./data/index
DOCS_PATH=./data/documents

# Retrieval Configuration
RETRIEVAL_MODE=multi_stage  # Options: basic, multi_stage
RETRIEVAL_TOP_K=5
RETRIEVAL_INITIAL_K=20
USE_ADAPTIVE=true

# Arabic Morphology
CAMEL_DB=arablmsr  # Options: arablmsr, arabic, calima-db-msa

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Gradio UI Configuration
GRADIO_PORT=7860
GRADIO_SHARE=false

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# APP_ENV=production is fail-closed until production identity/storage are implemented.
APP_ENV=development

# Local/staging API authentication. Use a long random value; never commit .env.
AUTH_ENABLED=true
AUTH_TOKEN=replace-with-a-random-32-byte-token
AUTH_WORKSPACE_ID=codespace-user
LOCAL_DEV_MODE=false  # tokenless mode requires both local-dev flags
PRIVATE_DEV_MODE=false  # true only when the Codespaces forwarded port is Private
MAX_UPLOAD_BYTES=26214400

# Cache Configuration
EMBEDDING_CACHE_SIZE=10000
EMBEDDING_CACHE_TTL=24  # hours
QUERY_CACHE_SIZE=1000
QUERY_CACHE_TTL=6  # hours

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100
